%! Influences between famous people (Wikidata, bound SPARQL imports).
%!
%! A SPARQL import with a `where` clause only asks the endpoint for the
%! data the program needs. Here, `where reached(?person)` restricts the
%! query to the people in the predicate `reached`, which Nemo sends along
%! with the query. The predicate in the `where` clause can be derived by
%! rules, even recursively: this program follows a chain of influences
%! through Wikidata and fetches new data in each round.
%!
%! The example shows:
%! - how to restrict a SPARQL import to the values of a predicate,
%! - how such imports follow chains of values derived by rules,
%! - how to fetch labels only for the items the program found.

@prefix wd: <http://www.wikidata.org/entity/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

item(wd:Q42) .    % Douglas Adams
item(wd:Q937) .   % Albert Einstein
item(wd:Q7186) .  % Marie Curie

% Who influenced whom, for every person reached so far:
@import influence(?person, ?other) from sparql {
    endpoint = <https://query.wikidata.org/sparql>,
    query = "SELECT ?person ?other WHERE { ?person <http://www.wikidata.org/prop/direct/P737> ?other }"
} where reached(?person) .

reached(?person) :- item(?person) .
reached(?other) :- influence(?person, ?other), ?person != ?other .

% English labels, only for the people reached:
@import caption(?item, ?text) from sparql {
    endpoint = <https://query.wikidata.org/sparql>,
    query = """
        SELECT ?item ?text WHERE {
            ?item rdfs:label ?text .
            FILTER(LANG(?text) = "en")
        }
    """,
    page = 500
} where reached(?item) .

influencedBy(?text, ?otherText) :-
    influence(?person, ?other), caption(?person, ?text), caption(?other, ?otherText) .

@output influencedBy .
