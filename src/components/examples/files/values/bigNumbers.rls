%! Exact arithmetic beyond 64 bits.
%!
%! Integers are not limited to 64 bits: where a result does not fit,
%! arithmetic continues with larger numbers instead of overflowing.
%! Comparisons, division and aggregates work on them like on any
%! other number.
%!
%! The example shows:
%! - how factorials grow past 64 bits,
%! - how large numbers compare, divide and add up.

% 30! has 33 digits:
factorial(0, 1) .
factorial(?n + 1, ?f * (?n + 1)) :- factorial(?n, ?f), ?n < 30 .

beyond64Bits(?n, ?f) :- factorial(?n, ?f), ?f > 9223372036854775807 .
half(?f / 2) :- factorial(30, ?f) .
total(#sum(?f per ?n)) :- factorial(?n, ?f) .

square(9223372036854775807 * 9223372036854775807) .
successor(9223372036854775807 + 1) .

@output beyond64Bits, half, total, square, successor .
