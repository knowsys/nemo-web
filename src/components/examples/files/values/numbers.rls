%! Integers, decimals, doubles and floats.
%!
%! A number with a point is an exact decimal: 0.1 is one tenth, not the
%! binary fraction closest to it, so 0.1 + 0.2 is exactly 0.3. Doubles
%! and floats are written with a suffix (2.5d, 2.5f) or an exponent
%! (2.5E0). Dividing integers gives their exact quotient, and arithmetic
%! on different kinds of numbers gives the later kind in the order
%! integer, decimal, float, double, as in SPARQL.
%!
%! The example shows:
%! - how to write the four kinds of numbers,
%! - how decimal arithmetic stays exact,
%! - how division and mixed arithmetic behave,
%! - how numbers of different kinds compare by their exact values.

kinds(5, 2.5, 2.5d, 2.5f) .
kindNames(DATATYPE(5), DATATYPE(2.5), DATATYPE(2.5d), DATATYPE(2.5f)) .

% Decimals are exact, so 0.1 + 0.2 is three tenths; in doubles, it is not:
total(decimal, 0.1 + 0.2) .
total(double, 0.1d + 0.2d) .
threeTenths(?kind) :- total(?kind, ?total), ?total == 0.3 .

% Integral decimals are integers:
whole(6.5 - 1.5) .

% Dividing integers gives the exact quotient, a decimal where needed:
quotient(?x, ?y, ?x / ?y) :- pair(?x, ?y) .
pair(7, 2) .
pair(8, 4) .
pair(-7, 2) .

% Mixed arithmetic gives the later kind in the order integer, decimal, float, double:
mixed(1 + 0.5, 1 + 0.5d, 0.5d + 0.5f) .

% Numbers of different kinds compare by their exact values:
% 0.3 is greater than the double 0.3d, which is 0.29999999999999998889...
above(?a, ?b) :- number(?a, ?x), number(?b, ?y), ?x > ?y .
number(decimal, 0.3) .
number(double, 0.3d) .

@output kinds, kindNames, total, threeTenths, whole, quotient, mixed, above .
