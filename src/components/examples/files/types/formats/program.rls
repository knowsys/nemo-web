%! Import formats and declarations.
%!
%! The format of an import says how each cell of a file is read as a
%! value. A row with a cell that cannot be read is skipped as malformed.
%! If an imported predicate also has a declaration, the formats must
%! guarantee the declared types, either alone or together with the
%! conditions in the `where` clause of the import, which filter the rows.
%! The files read here are the input files of this example (see "Input
%! files" next to the run button).
%!
%! The example shows:
%! - how a declaration alone decides how CSV cells are read,
%! - how different formats read the same file in different ways,
%! - how the conditions of a `where` clause ensure the declared types of
%!   an RDF import,
%! - how malformed rows are reported.

@prefix ex: <http://example.org/> .

% Declaration only: each column is read according to its type, so an
% `int` column is parsed as an integer, a `string` column is read as it
% is written, and an `iri` column is read as an IRI. Line 3 of people.csv
% is malformed because its age is not an integer, and line 4 because it
% has only two columns. The other rows are read.
@declare person(name: string, age: int, tag: iri) .
@import person from csv { resource = "people.csv" } .

% Format only: `string` reads a cell as it is written, and `term` reads
% it as it would be read in a program, where bare words are IRIs. This
% reads the same file in two ways.
@import plain from csv { resource = "mixed.csv", format = (string, string) } .
@import terms from csv { resource = "mixed.csv", format = (int, term) } .

% Format and declaration: a `term` column is read according to the
% declared type, so the first column is read as a string, and 42 does not
% become an integer.
@declare labeled(code: string, who: iri) .
@import labeled from csv { resource = "mixed.csv", format = (term, term) } .

% In RDF, a subject can be an IRI or a blank node, and an object can be
% any term. The `where` clause keeps only the triples whose subject is an
% IRI and whose object is an integer, so the declared types hold. The
% other triples are skipped without a warning.
@declare age(who: iri, of: iri, years: int) .
@import age(?who, ?of, ?years) from ntriples { resource = "ages.nt" }
    where ISIRI(?who), ISINTEGER(?years) .

adult(?who) :- age(?who, ex:age, ?years), ?years >= 18 .

@output person, plain, terms, labeled, adult .
