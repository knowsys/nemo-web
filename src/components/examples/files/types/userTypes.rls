%! User-defined types.
%!
%! @type defines a type of structured values by a label and the types of
%! its parts. A type can use other types as parts. A type with a single
%! part, such as angle(decimal), is a type of its own: the value
%! angle(0.5) is different from the decimal 0.5. Nemo checks that every
%! value of a defined type fits its definition, including values built by
%! rules.
%!
%! The example shows:
%! - how to define tuple types, map types and a type with a single part,
%! - how to use them in declarations,
%! - how to build and match values of these types in rules.

@type point(int, int) .
@type segment(point, point) .
@type angle(decimal) .
@type config {host: string, port: int} .

@declare road(span: segment, name: string) .
@declare rotation(by: angle) .
@declare server(config) .

road(segment(point(1, 2), point(3, 4)), "A4") .
road(segment(point(0, 0), point(0, 5)), "B2") .
rotation(angle(0.5)) .
rotation(angle(2)) .
server(config{host = "localhost", port = 8080}) .
plain(0.5) .

shifted(segment(point(?x1 + 1, ?y1), point(?x2 + 1, ?y2)), ?name) :-
    road(segment(point(?x1, ?y1), point(?x2, ?y2)), ?name) .
vertical(?name) :- road(segment(point(?x, _), point(?x, _)), ?name) .
turns(?value) :- rotation(angle(?value)) .
port(?host, ?port) :- server(config{host = ?host, port = ?port}) .

% An angle is not a decimal, so this rule can never fire:
sameAsPlain(?a) :- rotation(?a), plain(?a) .

@output shifted, vertical, turns, port, sameAsPlain .
