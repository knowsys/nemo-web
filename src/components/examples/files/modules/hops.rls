%! Pairs of nodes within a number of hops of each other.
%!
%! This file is a module. A program uses it with `@use hops`, binds the
%! input `edge` to one of its own predicates, can set the parameter
%! `$limit`, and reads the output `within`.

@input edge(from: any, to: any) .
@parameter $limit: int = 3 .

hops(?x, ?y, 1) :- edge(?x, ?y) .
hops(?x, ?z, ?n + 1) :- hops(?x, ?y, ?n), edge(?y, ?z), ?n < $limit .
within(?x, ?y) :- hops(?x, ?y, _) .

@output within .
