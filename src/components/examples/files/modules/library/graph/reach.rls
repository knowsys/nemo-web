%! The number of nodes each node of a relation reaches.
%!
%! This module uses closure.rls from the same folder, so it can write
%! `@use closure` without the folder name.

@input edge(from: any, to: any) .

@use closure { edge = edge } as closed .

reaches(?x, #count(?y)) :- closed::path(?x, ?y) .

@output reaches .
