%! A library of modules in a folder.
%!
%! Module names follow folders: `@use graph::closure` reads the input
%! file graph/closure.rls, and graph/reach.rls, in the same folder,
%! reads it with just `@use closure`. To use modules of your own, add
%! .rls files as input files and give them names with their folders,
%! such as graph/closure.rls.
%!
%! The example shows:
%! - how module names follow the folders of the input files,
%! - how a module uses another module beside it.

@use graph::closure { edge = follows } as social .
@use graph::reach { edge = follows } as counted .

follows(ada, bob) .
follows(bob, cho) .
follows(cho, ada) .
follows(cho, dan) .

reachable(?x, ?y) :- social::path(?x, ?y) .
reachCount(?x, ?n) :- counted::reaches(?x, ?n) .

@output reachable, reachCount .
