%! Names with hyphens.
%!
%! A `-` between two parts of a name belongs to the name, as in SPARQL's
%! prefixed names: stock-item, item-1 and ex:spare-part are names. After
%! a variable it stays a minus, so ?count-1 subtracts, and with spaces
%! around it a `-` always subtracts.
%!
%! The example shows:
%! - how to write predicate and constant names with hyphens,
%! - how `-` subtracts after a variable.

@prefix ex: <https://example.org/> .

stock-item(item-1, 5) .
stock-item(ex:spare-part, 3) .

reduced(?item, ?count-1) :- stock-item(?item, ?count) .
spaced(?item, ?count - 1) :- stock-item(?item, ?count) .

@output stock-item, reduced, spaced .
