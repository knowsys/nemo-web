%! Names with hyphens.
%!
%! Names can contain hyphens, as prefixed names in SPARQL can: stock-item,
%! item-1 and ex:spare-part are names. After a variable, `-` is a minus
%! sign, so ?count-1 subtracts 1. With spaces around it, `-` is always a
%! minus sign.
%!
%! The example shows:
%! - how to write predicate and constant names with hyphens,
%! - how `-` subtracts after a variable.

@prefix ex: <https://example.org/> .

stock-item(item-1, 5) .
stock-item(ex:spare-part, 3) .

reduced(?item, ?count-1) :- stock-item(?item, ?count) .
spaced(?item, ?count - 1) :- stock-item(?item, ?count) .

@output stock-item, reduced, spaced .
