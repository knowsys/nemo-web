%%% Shortest paths in weighted directed graph (i.e. each edge is assigned a cost)

e(1,2,7).e(1,4,2).e(1,7,15).e(2,3,17).e(2,9,3).e(3,5,9).e(3,8,14).e(4,2,6).e(4,6,1).
e(5,1,8).e(5,10,2).e(6,3,13).e(6,9,3).e(7,5,5).e(8,2,4).e(9,7,2).e(9,10,9).

totalCost(#sum(?cost per ?from, ?to)) :- e(?from, ?to, ?cost).

reachableIn(?from, ?to, ?cost) :- e(?from, ?to, ?cost).
reachableIn(1, ?to, ?cost1+?cost2) :- reachableIn(1, ?mid, ?cost1), e(?mid, ?to, ?cost2), totalCost(?totalCost), ?cost1 + ?cost2 < ?totalCost.

minDistancesFromNode1(?to, #min(?cost)) :- reachableIn(1, ?to, ?cost), ?to != 1.

