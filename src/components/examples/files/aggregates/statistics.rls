%! Several aggregates in one rule.
%!
%! A rule head can contain several aggregates, which are computed over
%! the same group. Sums of decimals are exact, and sums of integers can
%! exceed 64 bits. The average of integers is a decimal, rounded after
%! 18 decimal places if it does not terminate.
%!
%! The example shows:
%! - how to compute several aggregates over the same group,
%! - how sums and averages of integers and decimals are computed.

sale(north, monday, 10) .
sale(north, tuesday, 30) .
sale(north, wednesday, 15) .
sale(south, monday, 0.1) .
sale(south, tuesday, 0.2) .
sale(east, monday, 9223372036854775807) .
sale(east, tuesday, 9223372036854775807) .

statistics(?region, #count(), #sum(?amount per ?day), #min(?amount), #max(?amount), #avg(?amount per ?day)) :-
    sale(?region, ?day, ?amount) .

@output statistics .
