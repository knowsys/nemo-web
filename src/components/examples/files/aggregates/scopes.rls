%! Which values an aggregate counts.
%!
%! An aggregate such as #sum(?p) uses each distinct value of ?p once per
%! group: if two items have the same price, that price is added only
%! once. To add the price once for every item, write #sum(?p per ?item).
%! The value is then counted once for each distinct combination of the
%! variables after `per`. #count() without a variable counts the matches
%! of the rule body.
%!
%! The example shows:
%! - how #sum adds up distinct values,
%! - how `per` counts a value once per item, or once per item and day,
%! - how #count() counts body matches, and #count(per ...) combinations.

@declare price(item: iri, kind: iri, price: decimal) .

price(apple, fruit, 2) .
price(date, fruit, 2) .
price(cherry, fruit, 5) .
price(carrot, vegetable, 2) .
price(leek, vegetable, 3) .

stocked(apple, monday, alice) .
stocked(apple, monday, bob) .
stocked(apple, tuesday, alice) .
stocked(date, monday, alice) .
stocked(cherry, monday, carol) .

% Apple and date both cost 2, so 2 is added only once:
distinctPrices(?kind, #sum(?p)) :- price(?item, ?kind, ?p) .

% The price of each item is added once:
itemTotal(?kind, #sum(?p per ?item)) :- price(?item, ?kind, ?p) .
itemAverage(?kind, #avg(?p per ?item)) :- price(?item, ?kind, ?p) .

% The price of each item is added once for every day it is in stock:
dailyValue(?kind, #sum(?p per ?item, ?day)) :- price(?item, ?kind, ?p), stocked(?item, ?day, _) .

% Apple was stocked twice on Monday, by Alice and by Bob. #count() counts
% both matches, #count(per ?item, ?day) counts the pair (apple, monday) once:
matches(?kind, #count()) :- price(?item, ?kind, ?p), stocked(?item, ?day, ?by) .
stockDays(?kind, #count(per ?item, ?day)) :- price(?item, ?kind, ?p), stocked(?item, ?day, ?by) .

@output distinctPrices, itemTotal, itemAverage, dailyValue, matches, stockDays .
